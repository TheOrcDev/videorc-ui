{
  "name": "videorc-ui",
  "version": "0.0.1",
  "private": true,
  "description": "The Videorc component library: a shadcn/ui registry and its docs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm examples:build && next dev",
    "build": "pnpm examples:build && pnpm theme:check && pnpm registry:build && next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "examples:build": "node scripts/build-examples.mjs",
    "theme:build": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs --check",
    "registry:build": "shadcn build",
    "og:build": "node scripts/build-social-images.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:install": "node scripts/test-install.mjs",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "jotai": "^3.0.1",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/estree": "^1.0.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "8.1.0",
    "vitest": "^5.0.5"
  }
}
