            "--border": "oklch(1 0 0 / 24%)",
            "--input": "oklch(1 0 0 / 24%)",
            "--muted-foreground": "oklch(0.8 0 0)",
            "--subtle": "oklch(0.68 0 0)",
            "--glass-cover-sidebar": "0.95",
            "--glass-cover-work": "0.95",
            "--glass-float-rim": "oklch(1 0 0 / 30%)",
            "--chip-rim": "oklch(1 0 0 / 30%)",
            "--keycap-rim": "oklch(1 0 0 / 30%)",
            "--chrome-edge": "oklch(1 0 0 / 55%)",
            "--chrome-plate-rim": "oklch(1 0 0 / 30%)",
            "--chrome-row-rim": "oklch(1 0 0 / 30%)"
          }
        },
        "@media (prefers-reduced-transparency: reduce)": {
          ":root, .dark": {
            "--glass-window": "var(--glass-solid)",
            "--glass-sidebar": "transparent",
            "--glass-content": "transparent"
          },
          "[data-chrome-ground]": {
            "display": "none"
          }
        },
        "@utility glass-chip": {
          "border-color": "var(--chip-rim)",
          "background-image": "linear-gradient(to bottom, var(--chip-fill-top), var(--chip-fill-bottom))",
          "box-shadow": "inset 0 1px 0 var(--chip-highlight), 0 1px 2px var(--chip-drop)"
        },
        "@utility glass-chip-tinted": {
          "border-color": "color-mix(in oklch, var(--chip-tone) var(--chip-tint-rim), transparent)",
          "background-image": "linear-gradient(to bottom, color-mix(in oklch, var(--chip-tone) var(--chip-tint-top), transparent), color-mix(in oklch, var(--chip-tone) var(--chip-tint-bottom), transparent))",
          "box-shadow": "inset 0 1px 0 var(--chip-highlight), 0 1px 2px var(--chip-drop)",
          "color": "color-mix(in oklch, var(--chip-tone) var(--chip-tint-ink), var(--chip-tint-ink-base))"
        },
        "@utility glass-float": {
          "border-color": "var(--glass-float-rim)",
          "background-color": "var(--glass-float)",
          "box-shadow": "var(--glass-float-drop)"
        },
        "@utility glass-float-dialog": {
          "border-color": "var(--glass-float-rim)",
          "background-color": "var(--glass-float-dialog)",
          "box-shadow": "var(--glass-float-dialog-drop)"
        },
        "@utility glass-float-tooltip": {
          "border-color": "var(--glass-float-rim)",
          "background-color": "var(--glass-float-tooltip)",
          "box-shadow": "var(--glass-float-drop)"
        },
        "@utility glass-dot": {
          "background-color": "var(--chip-tone, var(--muted-foreground))",
          "box-shadow": "0 0 0 2px color-mix(in oklch, var(--chip-tone, var(--muted-foreground)) 22%, transparent), 0 0 8px color-mix(in oklch, var(--chip-tone, var(--muted-foreground)) var(--chip-dot-glow), transparent)"
        },
        "@utility glass-keycap": {
          "border-color": "var(--keycap-rim)",
          "background-image": "linear-gradient(to bottom, var(--keycap-fill-top), var(--keycap-fill-bottom))",
          "box-shadow": "inset 0 1px 0 var(--keycap-highlight), inset 0 -1px 0 var(--keycap-base)"
        },
        "@utility chrome-fill": {
          "color": "var(--chrome-fill-ink)",
          "background-color": "var(--chrome-fill-flat)",
          "background-image": "linear-gradient(to bottom, var(--chrome-fill-stops))",
          "background-origin": "border-box",
          "--tw-shadow": "var(--chrome-fill-shadow)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)",
          "&:is(button, a):hover:not(:disabled)": {
            "background-image": "linear-gradient(var(--chrome-fill-lift), var(--chrome-fill-lift)), linear-gradient(to bottom, var(--chrome-fill-stops))"
          },
          "&:is(button, a):active:not(:disabled)": {
            "background-image": "linear-gradient(to top, var(--chrome-fill-stops))",
            "--tw-shadow": "var(--chrome-pressed-shadow)"
          },
          "&:disabled": {
            "background-image": "none",
            "--tw-shadow": "0 0 0 1px var(--chrome-edge)"
          }
        },
        "@utility chrome-plate": {
          "background-image": "linear-gradient(to bottom, var(--chrome-plate-top), var(--chrome-plate-bottom))",
          "background-origin": "border-box",
          "--tw-shadow": "inset 0 1px 0 var(--chrome-plate-hi), inset 0 0 0 1px var(--chrome-plate-rim)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"
        },
        "@utility chrome-bead": {
          "background-image": "radial-gradient(circle at 35% 30%, var(--chrome-bead-stops))",
          "--tw-shadow": "0 1px 2px var(--chrome-bead-drop)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"
        },
        "@utility chrome-bead-ink": {
          "background-image": "radial-gradient(circle at 35% 30%, var(--chrome-bead-ink-stops))",
          "--tw-shadow": "0 1px 2px var(--chrome-bead-ink-drop)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"
        },
        "@utility chrome-led": {
          "color": "var(--live-foreground)",
          "background-color": "var(--chrome-led-flat)",
          "background-image": "linear-gradient(to bottom, var(--chrome-led-stops))",
          "background-origin": "border-box",
          "--tw-shadow": "var(--chrome-led-shadow)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)",
          "&[data-lit]": {
            "--tw-shadow": "var(--chrome-led-shadow), 0 0 12px var(--chrome-led-glow)"
          },
          "&:is(button, a):hover:not(:disabled)": {
            "background-image": "linear-gradient(var(--chrome-led-lift), var(--chrome-led-lift)), linear-gradient(to bottom, var(--chrome-led-stops))"
          },
          "&:is(button, a):active:not(:disabled)": {
            "background-image": "linear-gradient(to top, var(--chrome-led-stops))",
            "--tw-shadow": "var(--chrome-pressed-shadow)"
          },
          "&:disabled": {
            "background-image": "none",
            "--tw-shadow": "0 0 0 1px var(--chrome-edge)"
          }
        },
        "@utility chrome-row-live": {
          "background-image": "linear-gradient(to bottom, var(--chrome-row-edge-stops)), linear-gradient(to bottom, var(--chrome-row-live-top), var(--chrome-row-live-bottom)), linear-gradient(var(--glass-solid), var(--glass-solid))",
          "background-size": "2px 100%, 100% 100%, 100% 100%",
          "background-repeat": "no-repeat",
          "background-origin": "border-box",
          "--tw-shadow": "inset 0 1px 0 var(--chrome-row-live-hi), inset 0 0 0 1px var(--chrome-row-rim)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)",
          "&:hover:not(:disabled)": {
            "background-image": "linear-gradient(to bottom, var(--chrome-row-edge-stops)), linear-gradient(var(--chrome-row-lift), var(--chrome-row-lift)), linear-gradient(to bottom, var(--chrome-row-live-top), var(--chrome-row-live-bottom)), linear-gradient(var(--glass-solid), var(--glass-solid))",
            "background-size": "2px 100%, 100% 100%, 100% 100%, 100% 100%"
          }
        },
        "@utility chrome-row-member": {
          "background-image": "linear-gradient(to bottom, var(--chrome-row-member-top), var(--chrome-row-member-bottom)), linear-gradient(var(--glass-solid), var(--glass-solid))",
          "background-origin": "border-box",
          "--tw-shadow": "inset 2px 0 0 var(--chrome-row-member-edge), inset 0 1px 0 var(--chrome-row-member-hi)",
          "box-shadow": "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)",
          "&:hover:not(:disabled)": {
            "background-image": "linear-gradient(var(--chrome-row-lift), var(--chrome-row-lift)), linear-gradient(to bottom, var(--chrome-row-member-top), var(--chrome-row-member-bottom)), linear-gradient(var(--glass-solid), var(--glass-solid))"
          }
        },
        "@utility tone-success": {
          "--chip-tone": "var(--success)"
        },
        "@utility tone-warning": {
          "--chip-tone": "var(--warning)"
        },
        "@utility tone-destructive": {
          "--chip-tone": "var(--destructive)"
        },
        "@utility tone-live": {
          "--chip-tone": "var(--live)"
        },
        "@utility tone-info": {
          "--chip-tone": "var(--info)"
        },
        "@utility tone-neutral": {
          "--chip-tone": "var(--muted-foreground)",
          "--chip-dot-glow": "0%"
        },
        ":root [data-sonner-toaster][data-sonner-theme]": {
          "--normal-bg": "var(--glass-float)",
          "--normal-border": "var(--glass-float-rim)",
          "--normal-text": "var(--popover-foreground)",
          "--border-radius": "var(--radius)",
          "--success-bg": "var(--glass-float)",
          "--success-border": "var(--glass-float-rim)",
          "--success-text": "var(--popover-foreground)",
          "--error-bg": "var(--glass-float)",
          "--error-border": "var(--glass-float-rim)",
          "--error-text": "var(--popover-foreground)",
          "--warning-bg": "var(--glass-float)",
          "--warning-border": "var(--glass-float-rim)",
          "--warning-text": "var(--popover-foreground)",
          "--info-bg": "var(--glass-float)",
          "--info-border": "var(--glass-float-rim)",
          "--info-text": "var(--popover-foreground)"
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-styled=\"true\"]": {
          "@apply glass-float": {}
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-type=\"success\"]": {
          "@apply tone-success": {}
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-type=\"error\"]": {
          "@apply tone-destructive": {}
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-type=\"warning\"]": {
          "@apply tone-warning": {}
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-type=\"info\"]": {
          "@apply tone-info": {}
        },
        ":root [data-sonner-toaster] [data-sonner-toast][data-type] [data-icon]": {
          "color": "var(--chip-tone)"
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-glass-window text-foreground": {},
            "color-scheme": "light"
          },
          ".dark body": {
            "color-scheme": "dark"
          },
          "html": {
            "@apply font-sans": {}
          },
          ":focus-visible": {
            "@apply outline-ring/70 outline-2 outline-offset-2": {}
          },
          "@media (prefers-reduced-motion: reduce)": {
            "*, ::before, ::after": {
              "animation-duration": "0.01ms !important",
              "animation-iteration-count": "1 !important",
              "transition-duration": "0.01ms !important",
              "scroll-behavior": "auto !important"
            }
          }
        }
      }
    },
    {
      "name": "desktop",
      "type": "registry:theme",
      "title": "Desktop base",
      "description": "How a desktop app's chrome behaves: chrome text does not select, the arrow is the pointer and the window does not rubber-band. Add it to an Electron or Tauri app; leave it out of a website.",
      "css": {
        "@layer base": {
          "html": {
            "user-select": "none",
            "-webkit-user-select": "none",
            "cursor": "default",
            "overscroll-behavior": "none"
          },
          "input, textarea, [contenteditable=\"true\"]": {
            "user-select": "text",
            "-webkit-user-select": "text"
          },
          "img": {
            "-webkit-user-drag": "none"
          }
        }
      }
    }
  ]
}
