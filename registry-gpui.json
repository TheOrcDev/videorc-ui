{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "videorc-gpui",
  "homepage": "https://ui.videorc.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:lib",
      "title": "Theme",
      "description": "Videorc's design tokens for GPUI, generated from the same stylesheet as the React theme, every appearance resolved to sRGB; the appearance a window draws, Increase Contrast and Reduce Motion; Liquid Chrome's rasterised fills, beads and token shadows; the overlay motion; and the kit's window frame. Every GPUI item depends on it.",
      "files": [
        {
          "path": "gpui/kit/src/theme.rs",
          "type": "registry:file",
          "target": "src/theme.rs"
        },
        {
          "path": "gpui/kit/src/tokens.rs",
          "type": "registry:file",
          "target": "src/tokens.rs"
        },
        {
          "path": "gpui/kit/src/chrome.rs",
          "type": "registry:file",
          "target": "src/chrome.rs"
        },
        {
          "path": "gpui/kit/src/motion.rs",
          "type": "registry:file",
          "target": "src/motion.rs"
        },
        {
          "path": "gpui/kit/src/window.rs",
          "type": "registry:file",
          "target": "src/window.rs"
        }
      ],
      "meta": {
        "flavour": "gpui",
        "crates": {
          "gpui": {
            "package": "gpui-pre",
            "version": "=0.3.14"
          },
          "gpui_base": {
            "package": "gpui-base",
            "version": "=0.11.0"
          },
          "image": {
            "version": "0.25",
            "default-features": false
          },
          "resvg": {
            "version": "=0.46.0",
            "default-features": false
          },
          "smallvec": {
            "version": "1"
          }
        },
        "patches": [
          "gpui-pre-apple"
        ]
      }
    },
